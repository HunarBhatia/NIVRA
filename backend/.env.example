# Copy to backend/.env and fill in. Never commit the real .env.

# development | test | production
NIVRA_ENVIRONMENT=development

# SQLite for development (D15). Production: PostgreSQL, e.g.
# NIVRA_DATABASE_URL=postgresql+psycopg://nivra:CHANGE_ME@localhost:5432/nivra
NIVRA_DATABASE_URL=sqlite:///./nivra-dev.db

# Key that encrypts optional emails at rest. Generate one with:
#   .venv/Scripts/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable the optional-email feature.
NIVRA_DATA_KEY=

# Must be true in production (cookies only over HTTPS).
NIVRA_COOKIE_SECURE=false

# Testing helpers such as "pretend the deadline passed". Must be false in production.
NIVRA_ENABLE_PROTOTYPE_TOOLS=true

# Login/registration attempts allowed per IP per window.
NIVRA_AUTH_RATE_LIMIT=10
NIVRA_AUTH_RATE_WINDOW_SECONDS=60

# AI agents (phase 5). none = templates and rules only (default).
NIVRA_LLM_PROVIDER=none
NIVRA_ANTHROPIC_API_KEY=
NIVRA_LLM_MODEL=claude-opus-5-5
NIVRA_LLM_EFFORT=low
# Optional, unverified Prune gateway (NIVRA_LLM_PROVIDER=prune)
NIVRA_PRUNE_API_KEY=
# Optional Maritime agent runtime (NIVRA_AGENT_RUNTIME=maritime)
NIVRA_AGENT_RUNTIME=local
NIVRA_MARITIME_API_KEY=
NIVRA_MARITIME_AGENT_ID=
