# Copy to deploy/.env.production and fill in. NEVER commit the real file.
# The API refuses to start in production if a required safety setting is wrong.

NIVRA_ENVIRONMENT=production
POSTGRES_PASSWORD=change-me-to-a-long-random-password
NIVRA_DATABASE_URL=postgresql+psycopg://nivra:change-me-to-a-long-random-password@db:5432/nivra

# Your public site address(es), https only.
NIVRA_ALLOWED_ORIGINS=["https://nivra.example.org"]
NIVRA_COOKIE_SECURE=true
NIVRA_ENABLE_PROTOTYPE_TOOLS=false
NIVRA_ENABLE_DEMO_SITES=false

# Encrypts optional emails. Generate once and keep it safe; losing it makes
# stored emails unreadable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NIVRA_DATA_KEY=

# AI drafting (optional). Without a key the assistant uses templates.
NIVRA_LLM_PROVIDER=gemini
GEMINI_API_KEY=
NIVRA_LLM_MODEL=gemini-3.1-flash-lite

# Email (optional). console = log only; smtp = send.
NIVRA_EMAIL_BACKEND=smtp
NIVRA_SMTP_HOST=
NIVRA_SMTP_PORT=587
NIVRA_SMTP_USERNAME=
NIVRA_SMTP_PASSWORD=
NIVRA_SMTP_FROM=Nivra <no-reply@nivra.example.org>

# Data retention (days)
NIVRA_RETENTION_AUDIT_DAYS=365
NIVRA_RETENTION_NOTIFICATIONS_DAYS=90
NIVRA_RETENTION_JOBS_DAYS=180
NIVRA_RETENTION_AGENT_RUNS_DAYS=180
